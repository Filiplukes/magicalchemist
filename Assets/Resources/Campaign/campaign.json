        {
          "who": "wren",
          "text": "What do I have to do?",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "Sweep. Carry. Obey. And never touch my books.",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "Watch closely. Silvarra first, then Virelen.",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "Now trace the sign of Life on the scroll. Steady hand.",
          "action": ""
        }
      ],
      "outro": [
