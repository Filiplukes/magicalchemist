        {
          "who": "wren",
          "text": "I just watched you. And remembered.",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "Hm. Clumsy, but potent. Unusually potent.",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "Go to sleep. Tomorrow at dawn, you'll be at my table.",
          "action": ""
        }
