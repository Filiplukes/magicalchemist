      "chapter": "Chapter 1 · The Gutter",
      "title": "The Gutter",
      "background": "Street",
      "goal": "Brew your first potion.",
      "intro": [
        {
          "who": "aldric",
          "text": "You there. How long since you last ate?",
          "action": ""
        },
        {
          "who": "wren",
          "text": "…Three days. Maybe four.",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "The street will kill you before winter does.",
          "action": ""
