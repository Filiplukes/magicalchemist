    {
      "id": "obedience",
      "title": "The Good Apprentice",
      "achievement": "ending_obedience",
      "unlocksRecipes": [],
      "lines": [
        {
          "who": "aldric",
          "text": "Yes… YES! I can feel the years falling away!",
          "action": ""
        },
        {
          "who": "wren",
          "text": "Master, you're… young?",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "Forty years I searched for blood touched by the Light. And it walked into my workshop, starving.",
          "action": ""
        },
        {
          "who": "wren",
          "text": "Touched by the Light? I don't understand…",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "You never did. That's what made you perfect.",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "Humans, Beastfolk… I set them at each other's throats, and not one of them ever looked at me.",
          "action": ""
        },
        {
          "who": "wren",
          "text": "You… you started the war?",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "War is perfect cover for an old man's work.",
          "action": ""
        },
        {
          "who": "wren",
          "text": "I… can't… stand…",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "Your blood has done its work, child. You were a good apprentice. Thank you.",
          "action": ""
        },
        {
          "who": "narrator",
          "text": "That night, the Usurper rose.",
          "action": ""
        },
        {
          "who": "narrator",
          "text": "Land by land, kingdom by kingdom, he took everything. Humans and Beastfolk alike knelt before him.",
          "action": ""
        },
        {
          "who": "narrator",
          "text": "And there was no hope left anywhere.",
          "action": ""
        }
      ]
    },
    {
      "id": "betrayal",
      "title": "Root of Betrayal",
      "achievement": "ending_betrayal",
