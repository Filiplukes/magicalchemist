      "id": 1,
      "chapter": "Chapter 1 · The Gutter",
      "title": "The Gutter",
      "background": "Street",
      "goal": "Play as the master and brew one potion.",
      "game": {
        "recipes": [
          "Health Potion"
        ],
        "herbs": [
          "Silvarra",
          "Aurabloom",
          "Verdensage",
          "Virelen"
        ],
        "goal": "potions",
        "target": 1,
        "sequential": true
      },
      "unlocksRecipes": [],
      "intro": [
        {
          "who": "aldric",
          "text": "You there. How long since you last ate?",
          "action": ""
        },
        {
          "who": "wren",
          "text": "…Three days. Maybe four.",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "The street will kill you before winter does.",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "I need hands in my workshop. Follow me, and you'll never starve again.",
          "action": ""
        },
        {
          "who": "wren",
          "text": "What do I have to do?",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "Sweep. Carry. Obey. And never touch my books.",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "Stop staring and make yourself useful. The first herb, then the fourth.",
          "action": ""
        },
        {
          "who": "wren",
          "text": "These ones?",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "Not those! You counted from the right. Always from the left, just like reading a book.",
          "action": ""
        },
        {
          "who": "wren",
          "text": "But I can't read.",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "Well, now you know. Left to right.",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "Now step back. Spells are not for a servant's hands. Don't even touch the scroll.",
          "action": ""
        },
        {
          "who": "narrator",
          "text": "Wren steps back into the shadows… but secretly watches every move the master makes.",
          "action": ""
        },
        {
          "who": "narrator",
          "text": "Just this once, you are the master. Brew the potion.",
          "action": ""
        }
      ],
      "outro": [
        {
          "who": "wren",
          "text": "It's… glowing.",
          "action": ""
        },
        {
          "who": "aldric",
          "text": "A Health Potion. Nothing special. Now go and scrub the floor.",
          "action": ""
        }
      ]
    },
